# Copie para .env e ajuste: cp .env.example .env
# O .env real está no .gitignore e não deve ser commitado.

# Banco (usado pelo docker-compose.yml)
POSTGRES_DB=minhaapi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API (.NET lê como ConnectionStrings:DefaultConnection via __ )
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=localhost;Port=5432;Database=minhaapi;Username=postgres;Password=postgres
